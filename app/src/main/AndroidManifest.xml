<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.RECORD_AUDIO"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-feature android:name="android.hardware.microphone" android:required="true"/>
 <application android:label="AudioRelay Grabber Pie" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/grabber_icon" android:allowBackup="false">
   <activity android:name=".MainActivity" android:exported="true">
     <intent-filter>
       <action android:name="android.intent.action.MAIN"/>
       <category android:name="android.intent.category.LAUNCHER"/>
     </intent-filter>
   </activity>
   <service android:name=".RecordingService" android:exported="false"/>
 </application>
</manifest>
